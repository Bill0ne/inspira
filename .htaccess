# === Inspira LIVE Environment (.htaccess) ===

# Redirect root to default language
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /de [L,R=301]

# Allow deploy script
<Files "deploy.php">
    Require all granted
</Files>

# Protect sensitive files
<FilesMatch "(\.env|composer\.json|composer\.lock|\.gitignore|\.git)">
    Require all denied
</FilesMatch>

# Skip public requests and existing files/folders
RewriteCond %{REQUEST_URI} ^/public/ [OR]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route everything else into /public
RewriteRule ^(.*)$ public/$1 [L]
