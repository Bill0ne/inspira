<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Sicherheit: sensible Dateien schützen ---
    <FilesMatch "(\.env|composer\.json|composer\.lock|\.gitignore|\.git)">
        Require all denied
    </FilesMatch>

    # --- GitHub Webhook erlauben ---
    <Files "deploy.php">
        Require all granted
    </Files>

    # --- ALLOW THEME ASSETS DIRECT ACCESS ---
    RewriteCond %{REQUEST_URI} ^themes/[^/]+/(css|js|fonts|images)/ - [L]

    # --- Laravel Routing ---
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
